{
  "id": "wireless-debug-reconnect",
  "name": "Reconnect adb when wireless debugging comes on",
  "description": "When the Wireless Debug Tile turns wireless debugging on, ask the workstation to run adb-reconnect so it reconnects to this phone. Fails quietly if the machine is off.",
  "enabled": true,
  "trigger": { "type": "setting_changed", "scope": "global", "key": "adb_wifi_enabled", "equals": "1" },
  "actions": [
    { "type": "wait", "ms": 2000 },
    {
      "type": "ssh",
      "host": "${params.host}",
      "user": "${params.user}",
      "command": "/usr/local/bin/adb-reconnect",
      "timeout_ms": 20000
    }
  ],
  "params": [
    { "key": "host", "label": "Workstation address", "type": "string", "value": "10.0.0.2" },
    { "key": "user", "label": "Login name", "type": "string", "value": "user" }
  ]
}
