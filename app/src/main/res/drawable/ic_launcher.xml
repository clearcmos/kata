<?xml version="1.0" encoding="utf-8"?>
<!--
  In drawable rather than mipmap: the mipmap convention exists so a launcher can pull a
  higher-density raster than the device uses, and this icon is vector all the way down.
  With minSdk 34 the -v26 qualifier is also dead, and mipmap-anydpi alone does not satisfy
  aapt for a manifest icon reference.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
